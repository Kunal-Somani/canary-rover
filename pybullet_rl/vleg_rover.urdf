<?xml version="1.0"?>
<robot name="v_leg_rover">

  <material name="chassis_red"><color rgba="0.95 0.05 0.05 1.0"/></material>
  <material name="leg_cyan"><color rgba="0.0 0.95 0.95 1.0"/></material>
  <material name="stand_blue"><color rgba="0.0 0.0 0.95 1.0"/></material>
  <material name="wheel_black"><color rgba="0.10 0.10 0.10 1.0"/></material>
  <material name="bolt_pink"><color rgba="0.95 0.0 0.95 1.0"/></material>

  <link name="base_link">
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.05" iyy="0.12" izz="0.14" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><box size="0.40 0.25 0.08"/></geometry>
      <material name="chassis_red"/>
    </visual>
    <collision>
      <geometry><box size="0.40 0.25 0.08"/></geometry>
    </collision>
  </link>

  <link name="stand_front">
    <inertial><mass value="1.0"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><box size="0.06 0.08 0.12"/></geometry><material name="stand_blue"/></visual>
    <collision><geometry><box size="0.06 0.08 0.12"/></geometry></collision>
  </link>
  <joint name="stand_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="stand_front"/>
    <origin xyz="0.12 0 0.10"/>
  </joint>

  <link name="stand_rear">
    <inertial><mass value="1.0"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><box size="0.06 0.08 0.12"/></geometry><material name="stand_blue"/></visual>
    <collision><geometry><box size="0.06 0.08 0.12"/></geometry></collision>
  </link>
  <joint name="stand_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="stand_rear"/>
    <origin xyz="-0.12 0 0.10"/>
  </joint>

  <link name="bolt_front">
    <inertial><mass value="0.5"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><cylinder radius="0.01" length="0.22"/></geometry><material name="bolt_pink"/></visual>
  </link>
  <joint name="bolt_front_joint" type="fixed">
    <parent link="stand_front"/>
    <child link="bolt_front"/>
    <origin xyz="0 0 0.03" rpy="1.5708 0 0"/>
  </joint>

  <link name="bolt_rear">
    <inertial><mass value="0.5"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><cylinder radius="0.01" length="0.22"/></geometry><material name="bolt_pink"/></visual>
  </link>
  <joint name="bolt_rear_joint" type="fixed">
    <parent link="stand_rear"/>
    <child link="bolt_rear"/>
    <origin xyz="0 0 0.03" rpy="1.5708 0 0"/>
  </joint>

  <link name="leg_left_front">
    <inertial><mass value="1.0"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual>
      <origin xyz="0.10 0 -0.10" rpy="0 0.7854 0"/>
      <geometry><box size="0.28 0.03 0.03"/></geometry>
      <material name="leg_cyan"/>
    </visual>
    <collision>
      <origin xyz="0.10 0 -0.10" rpy="0 0.7854 0"/>
      <geometry><box size="0.28 0.03 0.03"/></geometry>
    </collision>
  </link>
  <joint name="leg_left_front_joint" type="fixed">
    <parent link="stand_front"/>
    <child link="leg_left_front"/>
    <origin xyz="0 0.055 0.03"/>
  </joint>

  <link name="leg_left_rear">
    <inertial><mass value="1.0"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual>
      <origin xyz="-0.10 0 -0.10" rpy="0 -0.7854 0"/>
      <geometry><box size="0.28 0.03 0.03"/></geometry>
      <material name="leg_cyan"/>
    </visual>
    <collision>
      <origin xyz="-0.10 0 -0.10" rpy="0 -0.7854 0"/>
      <geometry><box size="0.28 0.03 0.03"/></geometry>
    </collision>
  </link>
  <joint name="leg_left_rear_joint" type="fixed">
    <parent link="stand_rear"/>
    <child link="leg_left_rear"/>
    <origin xyz="0 0.055 0.03"/>
  </joint>

  <link name="leg_right_front">
    <inertial><mass value="1.0"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual>
      <origin xyz="0.10 0 -0.10" rpy="0 0.7854 0"/>
      <geometry><box size="0.28 0.03 0.03"/></geometry>
      <material name="leg_cyan"/>
    </visual>
    <collision>
      <origin xyz="0.10 0 -0.10" rpy="0 0.7854 0"/>
      <geometry><box size="0.28 0.03 0.03"/></geometry>
    </collision>
  </link>
  <joint name="leg_right_front_joint" type="fixed">
    <parent link="stand_front"/>
    <child link="leg_right_front"/>
    <origin xyz="0 -0.055 0.03"/>
  </joint>

  <link name="leg_right_rear">
    <inertial><mass value="1.0"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual>
      <origin xyz="-0.10 0 -0.10" rpy="0 -0.7854 0"/>
      <geometry><box size="0.28 0.03 0.03"/></geometry>
      <material name="leg_cyan"/>
    </visual>
    <collision>
      <origin xyz="-0.10 0 -0.10" rpy="0 -0.7854 0"/>
      <geometry><box size="0.28 0.03 0.03"/></geometry>
    </collision>
  </link>
  <joint name="leg_right_rear_joint" type="fixed">
    <parent link="stand_rear"/>
    <child link="leg_right_rear"/>
    <origin xyz="0 -0.055 0.03"/>
  </joint>

  <link name="wheel_left_front">
    <inertial><mass value="1.0"/><origin rpy="1.5708 0 0"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual>
      <origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.06" length="0.04"/></geometry><material name="wheel_black"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.06" length="0.04"/></geometry>
    </collision>
  </link>
  <joint name="wheel_left_front_joint" type="continuous">
    <parent link="leg_left_front"/>
    <child link="wheel_left_front"/>
    <origin xyz="0.20 0.035 -0.20"/><axis xyz="0 1 0"/><dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="wheel_left_rear">
    <inertial><mass value="1.0"/><origin rpy="1.5708 0 0"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.06" length="0.04"/></geometry><material name="wheel_black"/></visual>
    <collision>
      <origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.06" length="0.04"/></geometry>
    </collision>
  </link>
  <joint name="wheel_left_rear_joint" type="continuous">
    <parent link="leg_left_rear"/>
    <child link="wheel_left_rear"/>
    <origin xyz="-0.20 0.035 -0.20"/><axis xyz="0 1 0"/><dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="wheel_right_front">
    <inertial><mass value="1.0"/><origin rpy="1.5708 0 0"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.06" length="0.04"/></geometry><material name="wheel_black"/></visual>
    <collision>
      <origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.06" length="0.04"/></geometry>
    </collision>
  </link>
  <joint name="wheel_right_front_joint" type="continuous">
    <parent link="leg_right_front"/>
    <child link="wheel_right_front"/>
    <origin xyz="0.20 -0.035 -0.20"/><axis xyz="0 1 0"/><dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="wheel_right_rear">
    <inertial><mass value="1.0"/><origin rpy="1.5708 0 0"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.06" length="0.04"/></geometry><material name="wheel_black"/></visual>
    <collision>
      <origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.06" length="0.04"/></geometry>
    </collision>
  </link>
  <joint name="wheel_right_rear_joint" type="continuous">
    <parent link="leg_right_rear"/>
    <child link="wheel_right_rear"/>
    <origin xyz="-0.20 -0.035 -0.20"/><axis xyz="0 1 0"/><dynamics damping="0.1" friction="0.005"/>
  </joint>

</robot>
